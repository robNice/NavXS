    <string name="disclosure_title">Toegankelijkheidsservice</string>
    <string name="disclosure_item_1">NavXS gebruikt de toegankelijkheidsservice van Android.</string>
    <string name="disclosure_item_2">De service is nodig om zwevende navigatieknoppen over geselecteerde apps te tonen.</string>
